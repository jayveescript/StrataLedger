{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "myapp",
    "Audience": "myapp-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173",
    "ApiBaseUrl": "http://localhost:5173"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@myapp.local",
    "FromName": "MyApp"
  },
  "Security": {
    "BreachedPasswordCheck": true,
    "PasswordHistoryDepth": 5
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": "",
    "DemoData": false
  }
}
