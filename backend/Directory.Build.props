<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1062;CA2007;CA1031;CA1054;CA1056;CA1002;CA1819;CA1308;CA1305;CA1307;CA1310;CA1304;CA1311;CA1862;CA1822;CA1034;CA1024;CA1515;CA1812;CA1852;CA1720;CA2227;CA1040;CA1000;CA1805;CA1869;CA5394;CA1873</NoWarn>
  </PropertyGroup>
</Project>
