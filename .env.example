# Copy to .env for docker compose. Change every secret before any shared or production use.
POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app
SUPERADMIN_EMAIL=you@yourcompany.com
SUPERADMIN_PASSWORD=Choose-A-Long-Unique-Passphrase-1!
SEED_DEMO_DATA=true
# Production: set API_ENVIRONMENT=Production and mount an RSA key (openssl genrsa -out jwt.pem 3072),
# then point JWT_SIGNING_KEY_PATH at the mounted file.
API_ENVIRONMENT=Development
JWT_SIGNING_KEY_PATH=
